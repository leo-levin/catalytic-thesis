<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0">
  <info><title>Key labels</title><id>keys</id><updated>2026-01-01T00:00:00+00:00</updated></info>
  <macro name="author"><names variable="author"><name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="contextual"/></names></macro>
  <citation><layout prefix="[" suffix="]" delimiter=", "><text variable="citation-label"/></layout></citation>
  <bibliography second-field-align="flush">
    <sort><key variable="citation-label"/></sort>
    <layout suffix=".">
      <text variable="citation-label" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <text macro="author"/>
        <text variable="title"/>
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <text variable="collection-title"/>
          <text variable="volume"/>
          <text variable="number"/>
          <text variable="page"/>
          <text variable="note"/>
          <date variable="issued"><date-part name="year"/></date>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
